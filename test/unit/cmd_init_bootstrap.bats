@test "B1: agent=claude-code → existing CLAUDE.md is not overwritten" {
  local tmp_dir; tmp_dir=$(mktemp -d)
  echo "SENTINEL_CONTENT" > "$tmp_dir/CLAUDE.md"
  (
    export PROJECT_ROOT="$tmp_dir"
    _load_init_fns
    _init_bootstrap_context "claude-code"
    grep -q "SENTINEL_CONTENT" "$tmp_dir/CLAUDE.md"
  )
  local rc=$?
  rm -rf "$tmp_dir"
  [ "$rc" -eq 0 ]
}

@test "B1: agent=claude-code → GEMINI.md is not created" {
  local tmp_dir; tmp_dir=$(mktemp -d)
  (
    export PROJECT_ROOT="$tmp_dir"
    _load_init_fns
    _init_bootstrap_context "claude-code"
    [ ! -f "$tmp_dir/GEMINI.md" ]
  )
  local rc=$?
  rm -rf "$tmp_dir"
  [ "$rc" -eq 0 ]
}

