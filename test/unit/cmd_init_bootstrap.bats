# ── B1: codex agent (no extra file) ──────────────────────────────────────────

@test "B1: agent=codex → no CLAUDE.md or GEMINI.md created" {
  local tmp_dir; tmp_dir=$(mktemp -d)
  (
    export PROJECT_ROOT="$tmp_dir"
    _load_init_fns
    _init_bootstrap_context "codex"
    [ ! -f "$tmp_dir/CLAUDE.md" ] && [ ! -f "$tmp_dir/GEMINI.md" ]
  )
  local rc=$?
  rm -rf "$tmp_dir"
  [ "$rc" -eq 0 ]
}

# ── B1: unknown stack fallback ────────────────────────────────────────────────

@test "B1: unknown stack → AGENTS.md still created with 'unknown'" {
  local tmp_dir; tmp_dir=$(mktemp -d)
  (
    export PROJECT_ROOT="$tmp_dir"
    _load_init_fns
    # Override stub after _load_init_fns to produce unknown stack
    stack_profile_init() {
      export PROJECT_STACK="unknown"
      export PROJECT_TEST_CMD=""
      export PROJECT_BUILD_CMD=""
      export PROJECT_PACKAGE_MANAGER="unknown"
    }
    _init_bootstrap_context "codex"
    [ -f "$tmp_dir/AGENTS.md" ] && grep -q "unknown" "$tmp_dir/AGENTS.md"
  )
  local rc=$?
  rm -rf "$tmp_dir"
  [ "$rc" -eq 0 ]
}
